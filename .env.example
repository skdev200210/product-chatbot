# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...

# Redis holding each turn's MCP context. The remote MCP server reads the same keys,
# so it must point at this instance too.
REDIS_URL=redis://localhost:6379/0

# Optional overrides (defaults shown)
# MODEL_NAME=claude-sonnet-5
# REQUEST_TIMEOUT_SECONDS=60
# MAX_CONVERSATION_MESSAGES=50
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
# MCP_SERVER_URL=https://markytics-mcp-server.markytics.ai/mcp
# MCP_CONTEXT_TTL_SECONDS=300
